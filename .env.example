# Database (used only by /api/health in this app; no images are stored server-side)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Branding
NEXT_PUBLIC_APP_NAME="Cutout Studio"
NEXT_PUBLIC_PARENT_SITE_URL=https://www.clippingworld.com
# NEXT_PUBLIC_LOGO_URL=https://www.clippingworld.com/mygykroo/2024/02/clipping-world-logo.webp

# Limits
NEXT_PUBLIC_MAX_FILE_MB=25
NEXT_PUBLIC_MAX_DECODED_MP=40
NEXT_PUBLIC_MAX_WORKING_SIDE=4096
NEXT_PUBLIC_DEFAULT_WORKING_SIDE=2560
NEXT_PUBLIC_MAX_OUTPUT_MP=16.7
NEXT_PUBLIC_MAX_BATCH=20

# Model weights host. Empty = Hugging Face hub (https://huggingface.co/).
# To self-host, mirror the model repos under e.g. https://tools.example.com/models/<repo-id>/resolve/main/...
# and set: NEXT_PUBLIC_MODEL_HOST=https://tools.example.com/models/
NEXT_PUBLIC_MODEL_HOST=

# Optional: restrict which sites may embed the app in an iframe (space-separated). Unset = any site may frame it.
# ALLOWED_FRAME_ANCESTORS="https://www.clippingworld.com https://clippingworld.com"
